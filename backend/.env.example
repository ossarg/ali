# Server
SERVER_PORT=8080
ENVIRONMENT=development

# Database
# Local: postgresql://libra:libra@localhost:5432/libra_legal
# Production: postgresql://user:password@aws-rds-host/dbname?sslmode=require
DATABASE_URL=postgresql://libra:libra@localhost:5432/libra_legal

# JWT
JWT_SECRET=your-secret-here

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Agent API key (used by Rachel and other agents)
# Generate with: openssl rand -hex 32
AGENT_KEY=your-agent-key-here
REDIS_URL=redis://localhost:6379
SISE_BASE_URL=https://sise-consultas.libraseguros.com.ar/Sise3GBELibraCoreprodConsultas
SISE_USERNAME=your_sise_username
SISE_PASSWORD=your_sise_password
